generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MITIGATED
  MONITORING
  RESOLVED
  CLOSED
}

enum ServiceLifecycleStatus {
  EXPERIMENTAL
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum ServiceVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
  PREVIEW
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum ServiceHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

enum HealthCheckType {
  HTTP_ENDPOINT
  TCP
  SYNTHETIC
  DEPENDENCY
  DATABASE
  CACHE
}

enum MetricType {
  COUNTER
  GAUGE
  HISTOGRAM
  SUMMARY
  STATE
}

enum MetricUnit {
  MILLISECONDS
  SECONDS
  BYTES
  PERCENT
  COUNT
  REQUESTS
  ERRORS
  CUSTOM
}

enum MetricAggregation {
  AVERAGE
  MINIMUM
  MAXIMUM
  SUM
  COUNT
  RATE
  PERCENTILE
  MOVING_AVERAGE
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertState {
  OK
  PENDING
  FIRING
  RESOLVED
  MUTED
}

enum AlertOperator {
  GREATER_THAN
  LESS_THAN
  EQUALS
  NOT_EQUALS
  BETWEEN
  OUTSIDE_RANGE
}

enum AIProviderType {
  OPENAI
  CLAUDE
  GEMINI
  GROQ
}

enum AIFeature {
  CHAT
  PLAYGROUND
  LOG_ANALYSIS
  STACKTRACE_EXPLANATION
  INCIDENT_SUMMARIZATION
  SQL_GENERATION
  API_DOCUMENTATION
  RELEASE_NOTES
}

enum AIMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AIRequestStatus {
  SUCCEEDED
  FAILED
}

model User {
  id                      String                       @id @default(uuid())
  email                   String                       @unique
  name                    String
  passwordHash            String?
  isActive                Boolean                      @default(true)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  deletedAt               DateTime?
  roleAssignments         UserRole[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthAccounts           OAuthAccount[]
  teamMemberships         TeamMember[]
  reportedIncidents       Incident[]                   @relation("IncidentReporter")
  assignedIncidents       Incident[]                   @relation("IncidentAssignee")
  comments                IncidentComment[]
  incidentTimelineEvents  IncidentTimelineEvent[]
  incidentMentions        IncidentMention[]            @relation("IncidentMentionedUser")
  uploadedAttachments     IncidentAttachment[]         @relation("IncidentAttachmentUploader")
  serviceDependencies     ServiceDependency[]          @relation("ServiceDependencyCreator")
  serviceDeployments      Deployment[]                 @relation("DeploymentActor")
  serviceHealthEvents     ServiceHealthTimelineEvent[] @relation("ServiceHealthTimelineActor")
  serviceMetricEvents     ServiceMetricTimelineEvent[] @relation("ServiceMetricTimelineActor")
  alertTimelineEvents     AlertTimelineEvent[]         @relation("AlertTimelineActor")
  aiConversations         AIConversation[]             @relation("AIConversationActor")
  aiPromptTemplates       PromptTemplate[]             @relation("PromptTemplateCreator")
  aiAuditEvents           AIAuditEvent[]               @relation("AIAuditActor")
  auditLogs               AuditLog[]

  @@index([emailVerifiedAt])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@index([isSystem])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id               String   @id @default(uuid())
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  id            String         @id @default(uuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  lastSeenAt    DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id                String        @id @default(uuid())
  sessionId         String
  tokenHash         String        @unique
  expiresAt         DateTime
  lastUsedAt        DateTime?
  rotatedAt         DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  replacedByTokenId String?       @unique
  createdAt         DateTime      @default(now())
  session           AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  previousToken     RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  sentToEmail String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Team {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  members   TeamMember[]
  services  Service[]

  @@index([deletedAt])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model Service {
  id                     String                       @id @default(uuid())
  name                   String
  slug                   String                       @unique
  description            String?
  ownerTeamId            String
  repositoryUrl          String?
  apiBaseUrl             String?
  documentationUrl       String?
  runbookUrl             String?
  lifecycleStatus        ServiceLifecycleStatus       @default(ACTIVE)
  visibility             ServiceVisibility            @default(INTERNAL)
  tier                   Int                          @default(2)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  deletedAt              DateTime?
  ownerTeam              Team                         @relation(fields: [ownerTeamId], references: [id])
  incidents              Incident[]
  environments           ServiceEnvironment[]
  upstreamDependencies   ServiceDependency[]          @relation("ServiceDependencyUpstream")
  downstreamDependencies ServiceDependency[]          @relation("ServiceDependencyDownstream")
  deployments            Deployment[]
  healthChecks           HealthCheck[]
  healthResults          HealthCheckResult[]
  healthEvaluations      ServiceHealthEvaluation[]
  healthTimelineEvents   ServiceHealthTimelineEvent[]
  metricDefinitions      MetricDefinition[]
  metricSeries           MetricSeries[]
  metricSamples          MetricSample[]
  metricTimelineEvents   ServiceMetricTimelineEvent[]
  alertRules             AlertRule[]

  @@index([ownerTeamId])
  @@index([lifecycleStatus])
  @@index([visibility])
  @@index([deletedAt])
}

model Environment {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  type        EnvironmentType
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  services    ServiceEnvironment[]
  deployments Deployment[]

  @@index([type])
  @@index([deletedAt])
}

model ServiceEnvironment {
  id            String      @id @default(uuid())
  serviceId     String
  environmentId String
  baseUrl       String?
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
  service       Service     @relation(fields: [serviceId], references: [id])
  environment   Environment @relation(fields: [environmentId], references: [id])

  @@unique([serviceId, environmentId])
  @@index([environmentId])
  @@index([deletedAt])
}

model ServiceDependency {
  id                  String    @id @default(uuid())
  upstreamServiceId   String
  downstreamServiceId String
  description         String?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?
  upstreamService     Service   @relation("ServiceDependencyUpstream", fields: [upstreamServiceId], references: [id])
  downstreamService   Service   @relation("ServiceDependencyDownstream", fields: [downstreamServiceId], references: [id])
  createdBy           User?     @relation("ServiceDependencyCreator", fields: [createdByUserId], references: [id])

  @@unique([upstreamServiceId, downstreamServiceId])
  @@index([downstreamServiceId])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model Deployment {
  id               String           @id @default(uuid())
  serviceId        String
  environmentId    String
  version          String
  commitSha        String?
  repositoryUrl    String?
  status           DeploymentStatus @default(PENDING)
  deployedByUserId String?
  startedAt        DateTime
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  service          Service          @relation(fields: [serviceId], references: [id])
  environment      Environment      @relation(fields: [environmentId], references: [id])
  deployedBy       User?            @relation("DeploymentActor", fields: [deployedByUserId], references: [id])

  @@index([serviceId, startedAt])
  @@index([environmentId, startedAt])
  @@index([status])
  @@index([deployedByUserId])
}

model HealthCheck {
  id                String                       @id @default(uuid())
  serviceId         String
  name              String
  type              HealthCheckType
  target            String?
  description       String?
  isCritical        Boolean                      @default(true)
  isEnabled         Boolean                      @default(true)
  intervalSeconds   Int                          @default(60)
  timeoutMs         Int                          @default(5000)
  staleAfterSeconds Int                          @default(300)
  configuration     Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  deletedAt         DateTime?
  service           Service                      @relation(fields: [serviceId], references: [id])
  results           HealthCheckResult[]
  timelineEvents    ServiceHealthTimelineEvent[]

  @@index([serviceId])
  @@index([type])
  @@index([isEnabled])
  @@index([deletedAt])
}

model HealthCheckResult {
  id             String              @id @default(uuid())
  serviceId      String
  healthCheckId  String
  status         ServiceHealthStatus
  responseTimeMs Int?
  message        String?
  checkedAt      DateTime
  createdAt      DateTime            @default(now())
  service        Service             @relation(fields: [serviceId], references: [id])
  healthCheck    HealthCheck         @relation(fields: [healthCheckId], references: [id])

  @@index([healthCheckId, checkedAt])
  @@index([serviceId, checkedAt])
  @@index([status])
}

model ServiceHealthEvaluation {
  id          String              @id @default(uuid())
  serviceId   String
  status      ServiceHealthStatus
  summary     String
  evaluatedAt DateTime
  createdAt   DateTime            @default(now())
  service     Service             @relation(fields: [serviceId], references: [id])

  @@index([serviceId, evaluatedAt])
  @@index([status])
}

model ServiceHealthTimelineEvent {
  id            String               @id @default(uuid())
  serviceId     String
  healthCheckId String?
  actorUserId   String?
  type          String
  message       String
  fromStatus    ServiceHealthStatus?
  toStatus      ServiceHealthStatus?
  metadata      Json?
  createdAt     DateTime             @default(now())
  service       Service              @relation(fields: [serviceId], references: [id])
  healthCheck   HealthCheck?         @relation(fields: [healthCheckId], references: [id])
  actor         User?                @relation("ServiceHealthTimelineActor", fields: [actorUserId], references: [id])

  @@index([serviceId, createdAt])
  @@index([healthCheckId])
  @@index([actorUserId])
  @@index([type])
}

model MetricRetentionPolicy {
  id                String             @id @default(uuid())
  name              String             @unique
  retentionDays     Int
  resolutionSeconds Int
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  definitions       MetricDefinition[]
  samples           MetricSample[]

  @@index([isDefault])
}

model MetricDefinition {
  id                 String                       @id @default(uuid())
  serviceId          String
  name               String
  displayName        String
  description        String?
  type               MetricType
  unit               MetricUnit
  customUnit         String?
  defaultAggregation MetricAggregation
  retentionPolicyId  String?
  isEnabled          Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deletedAt          DateTime?
  service            Service                      @relation(fields: [serviceId], references: [id])
  retentionPolicy    MetricRetentionPolicy?       @relation(fields: [retentionPolicyId], references: [id])
  series             MetricSeries[]
  samples            MetricSample[]
  timelineEvents     ServiceMetricTimelineEvent[]
  alertRules         AlertRule[]

  @@unique([serviceId, name])
  @@index([serviceId])
  @@index([type])
  @@index([unit])
  @@index([retentionPolicyId])
  @@index([deletedAt])
}

model MetricSeries {
  id                 String           @id @default(uuid())
  metricDefinitionId String
  serviceId          String
  labelHash          String
  labels             Json
  source             String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  lastSampleAt       DateTime?
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id])
  service            Service          @relation(fields: [serviceId], references: [id])
  samples            MetricSample[]

  @@unique([metricDefinitionId, labelHash, source])
  @@index([serviceId])
  @@index([metricDefinitionId])
  @@index([lastSampleAt])
}

model MetricSample {
  id                 String                 @id @default(uuid())
  metricDefinitionId String
  metricSeriesId     String
  serviceId          String
  timestamp          DateTime
  value              Float
  labels             Json
  source             String
  retentionPolicyId  String?
  createdAt          DateTime               @default(now())
  metricDefinition   MetricDefinition       @relation(fields: [metricDefinitionId], references: [id])
  metricSeries       MetricSeries           @relation(fields: [metricSeriesId], references: [id])
  service            Service                @relation(fields: [serviceId], references: [id])
  retentionPolicy    MetricRetentionPolicy? @relation(fields: [retentionPolicyId], references: [id])

  @@index([metricDefinitionId, timestamp])
  @@index([metricSeriesId, timestamp])
  @@index([serviceId, timestamp])
  @@index([retentionPolicyId])
}

model ServiceMetricTimelineEvent {
  id                 String            @id @default(uuid())
  serviceId          String
  metricDefinitionId String?
  actorUserId        String?
  type               String
  message            String
  fromValue          String?
  toValue            String?
  metadata           Json?
  createdAt          DateTime          @default(now())
  service            Service           @relation(fields: [serviceId], references: [id])
  metricDefinition   MetricDefinition? @relation(fields: [metricDefinitionId], references: [id])
  actor              User?             @relation("ServiceMetricTimelineActor", fields: [actorUserId], references: [id])

  @@index([serviceId, createdAt])
  @@index([metricDefinitionId])
  @@index([actorUserId])
  @@index([type])
}

model AlertRule {
  id                      String               @id @default(uuid())
  name                    String
  description             String?
  severity                AlertSeverity
  state                   AlertState           @default(OK)
  metricName              String?
  metricDefinitionId      String?
  serviceId               String?
  filters                 Json
  aggregation             MetricAggregation
  percentile              Float?
  evaluationWindowSeconds Int                  @default(3600)
  operator                AlertOperator
  thresholdValue          Float?
  thresholdMin            Float?
  thresholdMax            Float?
  isEnabled               Boolean              @default(true)
  mutedUntil              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  metricDefinition        MetricDefinition?    @relation(fields: [metricDefinitionId], references: [id])
  service                 Service?             @relation(fields: [serviceId], references: [id])
  evaluations             AlertEvaluation[]
  timelineEvents          AlertTimelineEvent[]

  @@index([state])
  @@index([severity])
  @@index([serviceId])
  @@index([metricDefinitionId])
  @@index([deletedAt])
}

model AlertEvaluation {
  id               String      @id @default(uuid())
  alertRuleId      String
  previousState    AlertState?
  state            AlertState
  observedValue    Float?
  thresholdSummary String
  message          String
  evaluatedAt      DateTime
  createdAt        DateTime    @default(now())
  alertRule        AlertRule   @relation(fields: [alertRuleId], references: [id])

  @@index([alertRuleId, evaluatedAt])
  @@index([state])
}

model AlertTimelineEvent {
  id          String      @id @default(uuid())
  alertRuleId String
  actorUserId String?
  type        String
  message     String
  fromState   AlertState?
  toState     AlertState?
  metadata    Json?
  createdAt   DateTime    @default(now())
  alertRule   AlertRule   @relation(fields: [alertRuleId], references: [id])
  actor       User?       @relation("AlertTimelineActor", fields: [actorUserId], references: [id])

  @@index([alertRuleId, createdAt])
  @@index([actorUserId])
  @@index([type])
}

model ProviderConfiguration {
  id                    String           @id @default(uuid())
  provider              AIProviderType   @unique
  displayName           String
  model                 String
  isEnabled             Boolean          @default(true)
  priority              Int              @default(10)
  maxTokens             Int              @default(4096)
  temperature           Float            @default(0.2)
  costPer1KInputTokens  Float            @default(0)
  costPer1KOutputTokens Float            @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  conversations         AIConversation[]
  usageRecords          AIUsageRecord[]

  @@index([isEnabled, priority])
}

model PromptTemplate {
  id              String    @id @default(uuid())
  key             String
  version         Int
  name            String
  description     String?
  feature         AIFeature
  systemPrompt    String
  userPrompt      String
  variables       Json
  isActive        Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       User?     @relation("PromptTemplateCreator", fields: [createdByUserId], references: [id])

  @@unique([key, version])
  @@index([key, isActive])
  @@index([feature, isActive])
  @@index([createdByUserId])
}

model AIConversation {
  id               String                  @id @default(uuid())
  title            String
  feature          AIFeature
  provider         AIProviderType
  model            String
  providerConfigId String?
  actorUserId      String
  context          Json
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  actor            User                    @relation("AIConversationActor", fields: [actorUserId], references: [id])
  providerConfig   ProviderConfiguration?  @relation(fields: [providerConfigId], references: [id])
  messages         AIConversationMessage[]
  usageRecords     AIUsageRecord[]

  @@index([actorUserId, createdAt])
  @@index([feature, createdAt])
  @@index([provider])
  @@index([deletedAt])
}

model AIConversationMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AIMessageRole
  content        String
  metadata       Json?
  tokenCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@index([role])
}

model AIUsageRecord {
  id                    String                 @id @default(uuid())
  provider              AIProviderType
  model                 String
  feature               AIFeature
  providerConfigId      String?
  conversationId        String?
  conversationMessageId String?
  promptTokens          Int
  completionTokens      Int
  totalTokens           Int
  latencyMs             Int
  estimatedCostUsd      Float
  status                AIRequestStatus
  errorMessage          String?
  createdAt             DateTime               @default(now())
  providerConfig        ProviderConfiguration? @relation(fields: [providerConfigId], references: [id])
  conversation          AIConversation?        @relation(fields: [conversationId], references: [id])

  @@index([provider, createdAt])
  @@index([feature, createdAt])
  @@index([conversationId])
  @@index([status])
}

model AIAuditEvent {
  id          String          @id @default(uuid())
  actorUserId String?
  action      String
  feature     AIFeature
  provider    AIProviderType?
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime        @default(now())
  actor       User?           @relation("AIAuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([feature, createdAt])
  @@index([provider])
  @@index([action])
}

model Incident {
  id             String                  @id @default(uuid())
  title          String
  description    String?
  severity       IncidentSeverity
  priority       IncidentPriority
  status         IncidentStatus          @default(OPEN)
  serviceId      String
  reporterId     String
  assigneeId     String?
  customerImpact String?
  startedAt      DateTime                @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  service        Service                 @relation(fields: [serviceId], references: [id])
  reporter       User                    @relation("IncidentReporter", fields: [reporterId], references: [id])
  assignee       User?                   @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  comments       IncidentComment[]
  timelineEvents IncidentTimelineEvent[]
  attachments    IncidentAttachment[]
  mentions       IncidentMention[]

  @@index([serviceId, createdAt])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([severity, status])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([updatedAt])
}

model IncidentComment {
  id         String            @id @default(uuid())
  incidentId String
  authorId   String
  body       String
  editedAt   DateTime?
  createdAt  DateTime          @default(now())
  deletedAt  DateTime?
  incident   Incident          @relation(fields: [incidentId], references: [id])
  author     User              @relation(fields: [authorId], references: [id])
  mentions   IncidentMention[]

  @@index([incidentId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

model IncidentMention {
  id              String          @id @default(uuid())
  incidentId      String
  commentId       String
  mentionedUserId String
  handle          String
  createdAt       DateTime        @default(now())
  incident        Incident        @relation(fields: [incidentId], references: [id])
  comment         IncidentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser   User            @relation("IncidentMentionedUser", fields: [mentionedUserId], references: [id])

  @@unique([commentId, mentionedUserId])
  @@index([incidentId, createdAt])
  @@index([mentionedUserId])
  @@index([handle])
}

model IncidentAttachment {
  id               String    @id @default(uuid())
  incidentId       String
  uploadedByUserId String
  filename         String
  contentType      String
  size             Int
  storageKey       String
  uploadedAt       DateTime  @default(now())
  deletedAt        DateTime?
  incident         Incident  @relation(fields: [incidentId], references: [id])
  uploadedBy       User      @relation("IncidentAttachmentUploader", fields: [uploadedByUserId], references: [id])

  @@unique([storageKey])
  @@index([incidentId, uploadedAt])
  @@index([uploadedByUserId])
  @@index([deletedAt])
}

model IncidentTimelineEvent {
  id          String   @id @default(uuid())
  incidentId  String
  actorUserId String?
  type        String
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())
  incident    Incident @relation(fields: [incidentId], references: [id])
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([incidentId, createdAt])
  @@index([actorUserId])
  @@index([type])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
