NODE_ENV=development

# Apps
WEB_PORT=5173
API_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Leave blank locally to use the Vite /api proxy.
VITE_API_URL=
VITE_PLUSOPS_RECRUITER_DEMO_EMAIL=
VITE_PLUSOPS_RECRUITER_DEMO_PASSWORD=

# Database
DATABASE_URL=postgresql://plusops:plusops@localhost:5432/plusops?schema=public
PLUSOPS_RECRUITER_DEMO_EMAIL=viewer@plusops.local
PLUSOPS_RECRUITER_DEMO_PASSWORD=

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h
AUTH_REFRESH_COOKIE_NAME=plusops_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# OAuth placeholders
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI provider (OpenAI-compatible chat completions API)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Redis-backed distributed rate limiting. PostgreSQL remains authoritative.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1000

# Comma-separated exact hosts or *.domain suffixes allowed for outbound health probes.
HEALTH_CHECK_ALLOWED_HOSTS=localhost,127.0.0.1
