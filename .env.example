NODE_ENV=development

# Apps
WEB_PORT=5173
API_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Leave blank locally to use the Vite /api proxy.
VITE_API_URL=

# Database
DATABASE_URL=postgresql://plusops:plusops@localhost:5432/plusops?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OAuth placeholders
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
